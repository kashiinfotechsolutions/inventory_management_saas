{
  "name": "scoopstock-monorepo",
  "private": true,
  "packageManager": "npm@10.8.3",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace apps/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema=apps/api/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "turbo": "^2.1.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
